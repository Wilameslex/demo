<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.GeneExpressionMapper">
    <select id="queryExprBatch" resultType="java.util.Map">
        SELECT * FROM ${tableName}
        WHERE gene_id IN
        <foreach collection="geneIds" item="geneId" open="(" separator="," close=")">
            #{geneId}
        </foreach>
    </select>
</mapper>