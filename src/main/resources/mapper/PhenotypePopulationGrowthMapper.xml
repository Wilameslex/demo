<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.PhenotypePopulationGrowthMapper">
    <resultMap id="GrowthResultMap" type="com.example.demo.entity.PhenotypePopulationGrowth">
        <id column="id" property="id"/>
        <result column="population" property="population"/>
        <result column="date" property="date"/>
        <result column="number" property="number"/>
        <result column="carapace_length" property="carapaceLength"/>
        <result column="carapace_width" property="carapaceWidth"/>
        <result column="fat_factor" property="fatFactor"/>
        <result column="hepatopancreas_index" property="hepatopancreasIndex"/>
        <result column="gonad_index" property="gonadIndex"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="GrowthResultMap">
        SELECT * FROM phenotype_population_growth ORDER BY population ASC
    </select>
</mapper>